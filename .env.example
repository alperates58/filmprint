# Production Environment Variables Example for SineAI
# Copy this file to .env or configure in Coolify Environment Variables.

# --- MANDATORY PRODUCTION VARIABLES ---

# PostgreSQL Configuration
POSTGRES_DB=filmprint
POSTGRES_USER=filmprint
POSTGRES_PASSWORD=your_strong_postgres_password_here

# Database Connection URL (Internal Docker Container Network)
DATABASE_URL="postgresql://filmprint:your_strong_postgres_password_here@postgres:5432/filmprint?schema=public"

# Anonymous Session Security (Minimum 32 characters random string)
SESSION_SECRET="your_random_32_character_session_secret_here"

# Master Encryption Key (AES-256-GCM - Exactly 32 bytes / characters)
MASTER_ENCRYPTION_KEY="your_32_character_master_encryption_key_here"


# --- USER AUTHENTICATION & GOOGLE OAUTH VARIABLES ---

# Auth Secret for user session tokens (Minimum 32 characters random string)
AUTH_SECRET="your_random_32_character_auth_secret_here"

# Google Cloud OAuth Credentials (For regular end-user login)
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Canonical Production Application Base URL
NEXT_PUBLIC_APP_URL="https://sineai.com.tr"


# --- GROWTH & WEBMASTER INTEGRATIONS (PHASE I-B) ---

# Growth Google OAuth Credentials (GA4, Search Console, AdSense Read-Only)
# If omitted, falls back to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
GOOGLE_GROWTH_CLIENT_ID=""
GOOGLE_GROWTH_CLIENT_SECRET=""
# Optional explicit redirect URI override (Default: ${NEXT_PUBLIC_APP_URL}/api/admin/growth/google/callback)
GOOGLE_GROWTH_REDIRECT_URI=""

# Bing / Microsoft Webmaster OAuth Credentials
BING_WEBMASTER_CLIENT_ID=""
BING_WEBMASTER_CLIENT_SECRET=""
# Optional explicit redirect URI override (Default: ${NEXT_PUBLIC_APP_URL}/api/admin/growth/bing/callback)
BING_WEBMASTER_REDIRECT_URI=""

# Yandex Webmaster OAuth Credentials
YANDEX_WEBMASTER_CLIENT_ID=""
YANDEX_WEBMASTER_CLIENT_SECRET=""
# Optional explicit redirect URI override (Default: ${NEXT_PUBLIC_APP_URL}/api/admin/growth/yandex/callback)
YANDEX_WEBMASTER_REDIRECT_URI=""

# Optional fallback for GA4 Measurement ID (Preferred: configure via Admin Growth Panel)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""


# --- OPTIONAL FALLBACK VARIABLES ---

# Optional fallback only. Preferred production setup: configure TMDB from Admin Panel.
TMDB_API_KEY=""

# Optional fallback only. Preferred production setup: configure DeepSeek from Admin Panel.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL_ID="deepseek-v4-flash"


# --- MANDATORY ADMIN BOOTSTRAP CREDENTIALS ---

# Admin Bootstrap Credentials (Used only on initial boot if no AdminUser exists)
ADMIN_EMAIL="admin@filmprint.internal"
ADMIN_INITIAL_PASSWORD="your_strong_initial_admin_password_here"
