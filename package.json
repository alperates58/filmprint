{
  "name": "filmprint",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "@/*": "./*"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-worker.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "next start",
    "lint": "next lint",
    "type-check": "npm run type-check:app",
    "type-check:app": "tsc --project tsconfig.json --noEmit",
    "type-check:test": "tsc --project tsconfig.test.json --noEmit",
    "test": "tsx tests/runner.ts",
    "test:unit": "tsx tests/runner.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:e2e",
    "db:verify": "tsx scripts/db-verify.ts",
    "verify": "npm run verify:quick",
    "verify:quick": "npm run type-check:app",
    "verify:full": "prisma validate && npm run type-check:app && npm run type-check:test && npm run test:unit && npm run db:verify && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "quality:recommendations": "tsx tests/recommendation-quality/run.ts",
    "quality:hybrid": "tsx tests/recommendation-quality/run-hybrid-experiment.ts",
    "quality:tv": "tsx tests/tv-recommendation-quality/run.ts",
    "quality:hybrid:tv": "tsx tests/tv-recommendation-quality/run-hybrid-experiment.ts",
    "phase9:seed": "tsx tests/recommendation-quality/catalog-seed.ts",
    "tv:refresh-images": "tsx scripts/refresh-tv-images.ts",
    "audit:content-safety": "tsx scripts/audit-content-safety.ts",
    "backfill:tv-localization": "tsx scripts/backfill-tv-localization.ts",
    "backfill:movie-localization": "tsx scripts/backfill-movie-localization.ts",
    "catalog:worker": "tsx scripts/catalog-worker.ts",
    "catalog:worker:prod": "node dist/catalog-worker.js",
    "catalog:ingest": "tsx scripts/catalog-ingest.ts",
    "catalog:status": "tsx scripts/catalog-status.ts",
    "deepseek:migration-audit": "tsx scripts/deepseek-migration-audit.ts",
    "deepseek:refresh-legacy-artifacts": "tsx scripts/refresh-legacy-deepseek-artifacts.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "effect": "^3.13.0",
    "katex": "^0.18.4",
    "next": "^15.1.7",
    "postcss": "^8.4.49",
    "prisma": "^6.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1"
  }
}
