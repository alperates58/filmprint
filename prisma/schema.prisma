datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum InteractionStatus {
  WATCHED
  NOT_WATCHED
  UNSURE
}

enum TvInteractionStatus {
  WATCHED
  PARTIALLY_WATCHED
  NOT_WATCHED
  UNSURE
}

enum RatingStatus {
  LOVE
  LIKE
  NEUTRAL
  DISLIKE
}

enum RecommendationAction {
  LIKE
  DISLIKE
  HIDE
  WATCHLIST
  WATCH_LATER
  NOT_INTERESTED
  ALREADY_WATCHED
  WATCHED_FROM_RECOMMENDATION
}

enum MovieNightStatus {
  LOBBY
  READY
  COMPLETED
  CANCELLED
  EXPIRED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum AccountType {
  ANONYMOUS
  REGISTERED
}

enum AuthProvider {
  ANONYMOUS
  GOOGLE
  EMAIL
}

enum LibraryState {
  WATCHLIST
  WATCHED
  DROPPED
}

enum MediaType {
  FILM
  TV
}

enum ContentSafetyLevel {
  SAFE
  MATURE
  SEXUAL_CONTENT
  EROTIC
  ADULT
  UNKNOWN
}

enum GenrePreferenceLevel {
  PREFER
  NEUTRAL
  AVOID
  EXCLUDE
}

enum SubscriptionTier {
  FREE
  PREMIUM
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCEL_AT_PERIOD_END
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum EntitlementSource {
  BILLING
  MANUAL
  PROMOTIONAL
}

enum QuotaReservationStatus {
  RESERVED
  COMMITTED
  REFUNDED
}

enum BackfillJobStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

model User {
  id                      String                   @id @default(uuid())
  email                   String?                  @unique
  name                    String?
  image                   String?
  passwordHash            String?
  accountType             AccountType              @default(ANONYMOUS)
  provider                AuthProvider             @default(ANONYMOUS)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  lastSeenAt              DateTime                 @default(now())
  interactions            MovieInteraction[]
  tasteProfile            UserTasteProfile?
  recommendationFeedbacks  RecommendationFeedback[]
  tvInteractions          TvInteraction[]
  tvTasteProfile          UserTvTasteProfile?
  tvRecommendationFeedbacks TvRecommendationFeedback[]
  tvRecommendationExplanations TvRecommendationExplanation[]
  aiTasteProfiles         UserAiTasteProfile[]
  aiRecommendationSnapshots AiRecommendationSnapshot[]
  libraryEntries          UserContentLibrary[]
  hostedMovieNights       MovieNightSession[]      @relation("HostedMovieNights")
  movieNightMemberships   MovieNightMember[]
  movieNightVotes         MovieNightVote[]
  sessions                UserSession[]
  genrePreferences        UserGenrePreference[]
  entitlement             UserEntitlement?
  dailyFeatureUsages      FeatureUsageDaily[]
  quotaReservations       QuotaReservation[]
  billingCustomer         BillingCustomer?
  subscriptions           Subscription[]
  billingPayments         BillingPayment[]
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Movie {
  id                       String                   @id @default(uuid())
  tmdbId                   Int                      @unique
  title                    String
  originalTitle            String
  posterPath               String?
  backdropPath             String?
  releaseYear              Int?
  popularity               Float                    @default(0.0)
  voteAverage              Float                    @default(0.0)
  voteCount                Int                      @default(0)
  genreIds                 Int[]                    @default([])
  adult                    Boolean                  @default(false)
  contentRating            String?
  normalizedMinimumAge     Int?
  safetyLevel              ContentSafetyLevel       @default(UNKNOWN)
  calibrationPriorityScore Float                    @default(0.0)
  searchNormalizedTitle    String                   @default("")
  metadata                 Json                     @default("{}")
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  interactions             MovieInteraction[]
  recommendationFeedbacks  RecommendationFeedback[]
  libraryEntries           UserContentLibrary[]
  selectedInMovieNights    MovieNightSession[]      @relation("SelectedMovieNight")
  movieNightVotes          MovieNightVote[]

  @@index([popularity])
  @@index([voteAverage(sort: Desc), popularity(sort: Desc)])
  @@index([calibrationPriorityScore(sort: Desc)])
  @@index([safetyLevel, calibrationPriorityScore(sort: Desc)])
  @@index([releaseYear, calibrationPriorityScore(sort: Desc)])
}

model MovieInteraction {
  id         String            @id @default(uuid())
  userId     String
  movieId    String
  status     InteractionStatus
  rating     RatingStatus?
  answeredAt DateTime          @default(now())
  updatedAt  DateTime          @default(now()) @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId])
  @@index([movieId])
}

model UserTasteProfile {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  version                Int      @default(1)
  profileJson            Json     @default("{}")
  confidence             Float    @default(0.0)
  sourceInteractionCount Int      @default(0)
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecommendationExplanation {
  id             String   @id @default(uuid())
  userId         String
  movieId        String
  profileVersion Int      @default(1)
  matchVersion   Int      @default(1)
  headline       String
  explanation    String
  isAiGenerated  Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([userId, movieId, profileVersion, matchVersion])
  @@index([userId])
  @@index([movieId])
}

model RecommendationFeedback {
  id                 String               @id @default(uuid())
  userId             String
  movieId            String
  matchScore         Int                  @default(0)
  action             RecommendationAction
  source             String?              @default("RECOMMENDATIONS")
  engineVersion      Int?                 @default(3)
  deterministicScore Int?
  aiScore            Int?
  hybridScore        Int?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId])
  @@index([movieId])
  @@index([action])
}

model MovieNightSession {
  id              String           @id @default(uuid())
  code            String           @unique
  hostUserId      String
  status          MovieNightStatus @default(LOBBY)
  excludeWatched  Boolean          @default(true)
  selectedMovieId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  expiresAt       DateTime

  host          User               @relation("HostedMovieNights", fields: [hostUserId], references: [id], onDelete: Cascade)
  selectedMovie Movie?             @relation("SelectedMovieNight", fields: [selectedMovieId], references: [id], onDelete: SetNull)
  members       MovieNightMember[]
  votes         MovieNightVote[]

  @@index([code])
  @@index([hostUserId])
}

model MovieNightMember {
  id        String   @id @default(uuid())
  sessionId String
  userId    String
  isReady   Boolean  @default(false)
  joinedAt  DateTime @default(now())

  session MovieNightSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

model MovieNightVote {
  id        String   @id @default(uuid())
  sessionId String
  userId    String
  movieId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session MovieNightSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie   Movie             @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([movieId])
  @@index([userId])
}

model AdminUser {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  role         AdminRole       @default(ADMIN)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  lastLoginAt  DateTime?
  sessions     AdminSession[]
  auditLogs    AdminAuditLog[]
}

model AdminSession {
  id          String    @id @default(uuid())
  adminUserId String
  token       String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([token])
}

model IntegrationSecret {
  id             String   @id @default(uuid())
  provider       String   @unique
  encryptedValue String
  lastFour       String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  metadata  Json     @default("{}")
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id          String     @id @default(uuid())
  adminUserId String?
  action      String
  entityType  String?
  entityId    String?
  metadata    Json       @default("{}")
  createdAt   DateTime   @default(now())

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([action])
}

model TvShow {
  id                       String                   @id @default(uuid())
  tmdbId                   Int                      @unique
  name                     String
  originalName             String?
  overview                 String                   @default("")
  posterPath               String?
  backdropPath             String?
  firstAirDate             String?
  firstAirYear             Int?
  lastAirDate              String?
  status                   String?
  originalLanguage         String?
  popularity               Float                    @default(0.0)
  voteAverage              Float                    @default(0.0)
  voteCount                Int?
  genreIds                 Int[]                    @default([])
  adult                    Boolean                  @default(false)
  contentRating            String?
  normalizedMinimumAge     Int?
  safetyLevel              ContentSafetyLevel       @default(UNKNOWN)
  calibrationPriorityScore Float                    @default(0.0)
  searchNormalizedTitle    String                   @default("")
  metadata                 Json                     @default("{}")
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  interactions             TvInteraction[]
  recommendationFeedbacks  TvRecommendationFeedback[]
  recommendationExplanations TvRecommendationExplanation[]
  libraryEntries          UserContentLibrary[]

  @@index([popularity])
  @@index([voteAverage(sort: Desc), popularity(sort: Desc)])
  @@index([calibrationPriorityScore(sort: Desc)])
  @@index([safetyLevel, calibrationPriorityScore(sort: Desc)])
  @@index([firstAirYear, calibrationPriorityScore(sort: Desc)])
}

model TvInteraction {
  id         String              @id @default(uuid())
  userId     String
  tvShowId   String
  status     TvInteractionStatus
  rating     RatingStatus?
  answeredAt DateTime            @default(now())
  updatedAt  DateTime            @default(now()) @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tvShow TvShow @relation(fields: [tvShowId], references: [id], onDelete: Cascade)

  @@unique([userId, tvShowId])
  @@index([userId])
  @@index([tvShowId])
}

model UserTvTasteProfile {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  version                Int      @default(1)
  profileJson            Json     @default("{}")
  confidence             Float    @default(0.0)
  sourceInteractionCount Int      @default(0)
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TvRecommendationFeedback {
  id                 String               @id @default(uuid())
  userId             String
  tvShowId           String
  matchScore         Int                  @default(0)
  action             RecommendationAction
  source             String?              @default("RECOMMENDATIONS")
  engineVersion      Int?                 @default(1)
  deterministicScore Int?
  aiScore            Int?
  hybridScore        Int?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tvShow TvShow @relation(fields: [tvShowId], references: [id], onDelete: Cascade)

  @@unique([userId, tvShowId])
  @@index([userId])
  @@index([tvShowId])
  @@index([action])
}

model UserAiTasteProfile {
  id                     String    @id @default(uuid())
  userId                 String
  mediaType              MediaType @default(FILM)
  profileVersion         Int       @default(1)
  aiTasteVersion         Int       @default(1)
  model                  String
  tasteJson              Json      @default("{}")
  sourceEvidenceCount    Int       @default(0)
  inputFingerprint       String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaType])
  @@index([userId])
  @@index([mediaType])
}

model AiRecommendationSnapshot {
  id                   String    @id @default(uuid())
  userId               String
  mediaType            MediaType @default(FILM)
  profileVersion       Int       @default(1)
  matchVersion         Int       @default(32)
  aiTasteVersion       Int       @default(1)
  candidateFingerprint String
  model                String
  resultJson           Json      @default("{}")
  createdAt            DateTime  @default(now())
  expiresAt            DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaType, profileVersion, matchVersion, aiTasteVersion, candidateFingerprint])
  @@index([userId, mediaType, candidateFingerprint])
}

model TvRecommendationExplanation {
  id             String   @id @default(uuid())
  userId         String
  tvShowId       String
  profileVersion Int      @default(1)
  matchVersion   Int      @default(1)
  headline       String
  explanation    String
  isAiGenerated  Boolean  @default(true)
  createdAt      DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tvShow TvShow @relation(fields: [tvShowId], references: [id], onDelete: Cascade)

  @@unique([userId, tvShowId, profileVersion, matchVersion])
  @@index([userId])
  @@index([tvShowId])
}

enum CatalogIngestionMode {
  INITIAL_FILL
  MAINTENANCE
  PAUSED
}

enum CatalogCandidateStatus {
  IMPORTED
  REJECTED
  NOT_FOUND
  ADULT
  UNSAFE
  NO_USABLE_TITLE
  NO_OVERVIEW
  FAILED_RETRYABLE
}

model CatalogIngestionState {
  id                   String               @id @default(uuid())
  mediaType            MediaType            @unique
  enabled              Boolean              @default(false)
  mode                 CatalogIngestionMode @default(PAUSED)
  sourceDate           String?
  sourceCursor         Int                  @default(0)
  targetDailyItems     Int                  @default(10000)
  requestsPerSecond    Float                @default(1.0)
  concurrency          Int                  @default(2)
  initialTarget        Int                  @default(100000)
  processedToday       Int                  @default(0)
  insertedToday        Int                  @default(0)
  updatedToday         Int                  @default(0)
  rejectedToday        Int                  @default(0)
  rateLimitedToday     Int                  @default(0)
  failedToday          Int                  @default(0)
  lastCounterResetDate String?
  lastRunAt            DateTime?
  lastSuccessAt        DateTime?
  lastErrorAt          DateTime?
  lastError            String?
  lockedAt             DateTime?
  lockedBy             String?
  circuitOpenUntil     DateTime?
  consecutiveFailures  Int                  @default(0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([mediaType])
}

model CatalogCandidateState {
  id            String                 @id @default(uuid())
  mediaType     MediaType
  tmdbId        Int
  status        CatalogCandidateStatus
  reason        String?
  popularity    Float                  @default(0.0)
  attemptCount  Int                    @default(1)
  retryAfter    DateTime?
  lastCheckedAt DateTime               @default(now())
  metadata      Json                   @default("{}")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([mediaType, tmdbId])
  @@index([mediaType, status])
  @@index([retryAfter])
}

model UserContentLibrary {
  id         String       @id @default(uuid())
  userId     String
  mediaType  MediaType    @default(FILM)
  movieId    String?
  tvShowId   String?
  state      LibraryState @default(WATCHLIST)
  isFavorite Boolean      @default(false)
  addedAt    DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  watchedAt  DateTime?
  droppedAt  DateTime?
  metadata   Json         @default("{}")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie  Movie?  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  tvShow TvShow? @relation(fields: [tvShowId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@unique([userId, tvShowId])
  @@index([userId])
  @@index([mediaType])
  @@index([state])
  @@index([isFavorite])
  @@index([userId, mediaType, state])
  @@index([userId, isFavorite])
}

enum IndexNowStatus {
  PENDING
  PROCESSING
  SUBMITTED
  FAILED
}

model IndexNowSubmission {
  id            String          @id @default(cuid())
  url           String
  urlHash       String          @unique
  status        IndexNowStatus  @default(PENDING)
  retryCount    Int             @default(0)
  lastError     String?         @db.Text
  nextAttemptAt DateTime?       @default(now())
  submittedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

enum AdSurface {
  MOVIE
  TV
  GENRE
  EDITORIAL
  GLOBAL
}

enum AdDeviceTarget {
  ALL
  MOBILE
  DESKTOP
}

enum AdAudienceTarget {
  ALL
  ANONYMOUS_ONLY
  AUTHENTICATED_ONLY
}

enum AdSenseUnitState {
  ACTIVE
  ARCHIVED
  UNSPECIFIED
}

model AdPlacement {
  id               String            @id @default(uuid())
  key              String            @unique
  name             String
  description      String?
  surface          AdSurface         @default(GLOBAL)
  position         Int               @default(0)
  enabled          Boolean           @default(false)
  adUnitId         String?
  deviceTarget     AdDeviceTarget    @default(ALL)
  audience         AdAudienceTarget  @default(ANONYMOUS_ONLY)
  minViewportWidth Int?
  maxViewportWidth Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  adUnit           AdSenseInventoryUnit? @relation(fields: [adUnitId], references: [id], onDelete: SetNull)

  @@index([surface, enabled])
  @@index([key])
}

model AdSenseInventoryUnit {
  id                   String           @id @default(uuid())
  providerResourceName String           @unique
  reportingDimensionId String?
  displayName          String
  state                AdSenseUnitState @default(ACTIVE)
  type                 String?
  size                 String?
  adClientId           String?
  lastSyncedAt         DateTime         @default(now())
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  placements           AdPlacement[]

  @@index([state])
  @@index([reportingDimensionId])
}

model MonetizationSetting {
  id                   String   @id @default("default")
  adsMasterEnabled     Boolean  @default(false)
  publisherId          String?
  adClientId           String?
  adminPreviewMode     Boolean  @default(false)
  anonymousOnlyDefault Boolean  @default(true)
  maxAdsPerPage        Int      @default(2)
  cmpConfigured        Boolean  @default(false)
  cmpProvider          String   @default("google")
  adsTxtCustom         String?  @db.Text
  updatedAt            DateTime @updatedAt
}

model UserGenrePreference {
  id          String               @id @default(uuid())
  userId      String
  mediaType   MediaType            @default(FILM)
  genreId     Int
  preference  GenrePreferenceLevel @default(NEUTRAL)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaType, genreId])
  @@index([userId, mediaType])
}

model UserEntitlement {
  id           String            @id @default(uuid())
  userId       String            @unique
  tier         SubscriptionTier  @default(FREE)
  source       EntitlementSource @default(MANUAL)
  validUntil   DateTime?
  customLimits Json              @default("{}")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tier])
  @@index([source])
}

model FeatureUsageDaily {
  id          String    @id @default(uuid())
  userId      String
  featureKey  String
  usageDate   String
  count       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, featureKey, usageDate])
  @@index([userId, usageDate])
}

model CatalogBackfillJob {
  id             String            @id @default(uuid())
  jobType        String
  mediaType      MediaType
  status         BackfillJobStatus @default(PENDING)
  lastCursor     Int               @default(0)
  processedCount Int               @default(0)
  updatedCount   Int               @default(0)
  safeCount      Int               @default(0)
  matureCount    Int               @default(0)
  blockedCount   Int               @default(0)
  unknownCount   Int               @default(0)
  errorCount     Int               @default(0)
  lastError      String?
  startedAt      DateTime?
  lastRunAt      DateTime?
  completedAt    DateTime?
  metadata       Json              @default("{}")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([jobType, mediaType])
  @@index([status])
}

model QuotaReservation {
  id         String                 @id @default(uuid())
  userId     String
  featureKey String
  usageDate  String
  status     QuotaReservationStatus @default(RESERVED)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, featureKey, usageDate])
  @@index([status])
  @@index([status, createdAt])
}

model BillingCustomer {
  id                 String   @id @default(uuid())
  userId             String   @unique
  provider           String   @default("PAYTR")
  providerCustomerId String?
  encryptedUtoken    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([provider])
}

model Subscription {
  id                     String             @id @default(uuid())
  userId                 String
  provider               String             @default("PAYTR")
  providerSubscriptionId String?
  planKey                String             @default("SINEAI_PREMIUM")
  billingInterval        BillingInterval    @default(MONTHLY)
  status                 SubscriptionStatus @default(PENDING)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  cancelledAt            DateTime?
  endedAt                DateTime?
  gracePeriodEnd         DateTime?
  metadata               Json               @default("{}")
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments BillingPayment[]

  @@index([userId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@index([userId, status])
}

model BillingPayment {
  id                    String        @id @default(uuid())
  userId                String
  subscriptionId        String?
  provider              String        @default("PAYTR")
  merchantOid           String        @unique
  providerTransactionId String?
  amount                Float
  currency              String        @default("TRY")
  status                PaymentStatus @default(PENDING)
  failureCode           String?
  failureMessage        String?
  paidAt                DateTime?
  renewalKey            String?
  metadata              Json          @default("{}")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([merchantOid])
  @@index([subscriptionId])
  @@index([renewalKey])
}

model BillingWebhookEvent {
  id               String    @id @default(uuid())
  provider         String    @default("PAYTR")
  providerEventKey String?
  merchantOid      String
  payloadHash      String
  status           String
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?
  error            String?

  @@unique([provider, merchantOid, payloadHash])
  @@index([merchantOid])
  @@index([receivedAt])
  @@index([status])
}


